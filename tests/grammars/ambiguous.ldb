// Non-LL(1) decisions resolved by ALL(*) prediction; used by tparsecodegen.
grammar Ambiguous;

start : item* EOF ;
item  : 'alt' alt ';'
      | 'loop' loop ';'
      | 'opt' opt ';'
      | 'ix' ix ';'
      | 'plus' plus ';'
      ;
alt   : ID ID       # pair
      | ID INT      # num
      | ID          # one
      ;
loop  : (xs=ID ',')* last=ID ;
plus  : (ID '.')+ ID ;
opt   : (key=ID '=')? value=ID ;
ix    : ix '[' ix ']'           # index
      | ix '[' ix ':' ix ']'    # slice
      | ID                      # name
      ;

ID  : [a-z]+ ;
INT : [0-9]+ ;
WS  : [ \t\r\n]+ -> skip ;
