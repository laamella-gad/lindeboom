// Exercises every parser construct; used by tparsecodegen.
grammar Features;

start : item* EOF ;
item  : 'let' name=ID '=' value=expr ';'                 # let
      | 'list' '(' (xs=expr (',' xs=expr)*)? ')' ';'   # list
      | 'type' type=ID ('?' | '!')? ';'                  # typeDecl
      | 'raw' (~';')+ ';'                                # raw
      | 'any' label=. ';'                                # any
      | 'maybe' maybe ';'                                # opt
      | 'calc' calc ';'                                  # calcItem
      | 'sum' sum ';'                                    # sumItem
      | ';'                                              # empty
      ;
maybe : 'x' | ;
expr  : atom (op=('+' | '-') atom)* ;
atom  : ID | INT | '(' expr ')' | '-' INT ;
calc  : calc '(' ')'                                     # call
      | <assoc=right> left=calc '^' right=calc           # pow
      | '-' calc                                         # neg
      | left=calc op=('*' | '/') right=calc              # mul
      | left=calc op=('+' | '-') right=calc              # add
      | ID                                               # name
      | '[' calc ']'                                     # bracket
      ;
sum   : sum '+' INT | INT ;

ID      : [a-z]+ ;
INT     : [0-9]+ ;
WS      : [ \t\r\n]+ -> skip ;
COMMENT : '#' ~[\n]* -> channel(HIDDEN) ;
