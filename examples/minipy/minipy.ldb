// A small Python-like language: statements, blocks by indentation, expressions.
grammar MiniPy;

options {
  tabWidth = 8;
}

tokens { INDENT, DEDENT }

indentation {
  newline  = NL;
  indent   = INDENT;
  dedent   = DEDENT;
  brackets = '(' ')', '[' ']';
  tabs     = expand;
}

file      : stmt* EOF ;
stmt      : simpleStmt | compoundStmt ;
simpleStmt: smallStmt (';' smallStmt)* ';'? NL ;
smallStmt : 'pass'                               # pass
          | 'return' expr?                       # return
          | target=expr '=' value=expr           # assign
          | expr                                 # exprStmt
          ;
compoundStmt
          : ifStmt | whileStmt | funcDef ;
ifStmt    : 'if' cond=expr ':' then=block
            ('elif' expr ':' block)*
            ('else' ':' orelse=block)? ;
whileStmt : 'while' cond=expr ':' body=block ;
funcDef   : 'def' name=ID '(' params? ')' ':' body=block ;
params    : ID (',' ID)* ;
block     : simpleStmt
          | NL INDENT stmt+ DEDENT
          ;

expr      : expr '(' args? ')'                       # call
          | <assoc=right> left=expr '**' right=expr  # power
          | '-' expr                                 # neg
          | left=expr op=('*' | '/') right=expr      # mul
          | left=expr op=('+' | '-') right=expr      # add
          | left=expr op=('<' | '>' | '==') right=expr # compare
          | ID                                       # name
          | INT                                      # int
          | STRING                                   # str
          | '(' expr ')'                             # paren
          | '[' (expr (',' expr)*)? ']'              # list
          ;
args      : expr (',' expr)* ;

ID        : [a-zA-Z_] [a-zA-Z_0-9]* ;
INT       : DIGIT+ ;
STRING    : '"' (~["\\\r\n] | '\\' .)* '"' ;
NL        : '\r'? '\n' ;
WS        : [ \t]+                -> skip ;
COMMENT   : '#' ~[\r\n]*          -> skip ;
LINE_CONT : '\\' '\r'? '\n'       -> skip ;
fragment DIGIT : [0-9] ;
